# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated — collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
