# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (owns user identity for this site) ---
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe to ship to the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only, bypasses RLS.
# Leave blank unless something genuinely needs to escape RLS. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Strapi (content) ---
# Local: http://localhost:1337 — production: the DigitalOcean droplet URL
STRAPI_URL=http://localhost:1337
# Read-only API token from Strapi admin: Settings > API Tokens
STRAPI_API_TOKEN=
# Shared secret Strapi's webhook sends to /api/revalidate so edits refresh the site
REVALIDATE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
