# Copy to .env (NOT .env.local) and fill in.
#
# Use .env: Next reads both, but Payload's CLI only reads .env, so a value in
# .env.local is invisible to `payload migrate`, `generate:types`, etc.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payload ---
# Supabase dashboard > Connect > Session pooler.
# Replace [YOUR-PASSWORD] with the real database password, and percent-encode
# any of @ : / ? # [ ] % it contains.
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# openssl rand -base64 32   (Git Bash), or:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_SECRET=

# --- Email (required before production) ---
# Payload sends admin password resets. Without this they only reach the server
# log, which on Vercel means a forgotten password locks you out of /admin.
# Resend free tier: https://resend.com — verify pyrelightpress.com to send from it.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@pyrelightpress.com
EMAIL_FROM_NAME=Pyrelight Press

# --- Media storage (production) ---
# Vercel's serverless runtime has no persistent disk, so uploads must go to
# object storage. Supabase Storage over its S3-compatible endpoint.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (deferred) ---
# Nothing on the public site logs in until the shop ships. Payload provides
# editor auth. Revisit Supabase Auth / Auth0 / Clerk alongside Stripe.
