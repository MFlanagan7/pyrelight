# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payload CMS ---
# Postgres connection string. Supabase dashboard > Connect.
# Use the session pooler (5432) locally. On Vercel's serverless runtime use the
# transaction pooler (6543) with prepared statements disabled — Supavisor's
# transaction mode does not support them.
DATABASE_URI=
# Signs tokens and cookies. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# --- Media storage ---
# Supabase Storage over its S3-compatible endpoint. Serverless has no persistent
# disk, so uploads cannot go to local files in production.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (deferred) ---
# Nothing on the site logs in until the shop ships. Payload provides its own
# editor auth. Revisit Supabase Auth / Auth0 / Clerk alongside Stripe.
