# Copy to .env (NOT .env.local) and fill in.
#
# Use .env: Next reads both, but Payload's CLI only reads .env, so a value in
# .env.local is invisible to `payload migrate`, `generate:types`, etc.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payload ---
# Supabase dashboard > Connect > Session pooler.
# Replace [YOUR-PASSWORD] with the real database password, and percent-encode
# any of @ : / ? # [ ] % it contains.
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# openssl rand -base64 32   (Git Bash), or:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_SECRET=

# --- Email (required before production) ---
# Payload sends admin password resets. Without this they only reach the server
# log, which on Vercel means a forgotten password locks you out of /admin.
#
# Verify the SUBDOMAIN mail.pyrelightpress.com in Resend, not the root. Nothing
# programmatic then sends from the root, so its DMARC policy can go strict
# sooner, and a compromised key or a runaway send is contained to a subdomain
# that can be burned and re-verified. A root domain cannot be replaced.
# It also keeps the root's single permitted SPF record free for the mailbox
# provider, avoiding the two-SPF-records-invalidate-each-other trap.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mail.pyrelightpress.com
EMAIL_FROM_NAME=Pyrelight Press

# --- Media storage (production) ---
# Vercel's serverless runtime has no persistent disk, so uploads must go to
# object storage. Supabase Storage over its S3-compatible endpoint.
S3_ENDPOINT=
S3_REGION=
# Lowercase, hyphenated. Named for the parent brand, not the site: one Payload
# instance serves both Starfall and Pyrelight, so a site-specific name would be
# wrong once apps/pyrelight exists, and renaming means moving every object.
S3_BUCKET=pyrelight-media
# Set to "true" only once the bucket is public in the Supabase dashboard.
# Public objects serve from Supabase's CDN; private ones stream through a
# serverless function on every request. Keep paid downloads in a SEPARATE
# private bucket (pyrelight-downloads) — this flag disables Payload's access
# control on the media collection.
S3_PUBLIC_BUCKET=false
# Second, PRIVATE bucket for gated downloads. Must NOT be public: a file in a
# public bucket is a URL anyone can share, which defeats the email gate.
# Delivery is a short-lived signed URL issued after the form is completed.
S3_DOWNLOADS_BUCKET=pyrelight-downloads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (deferred) ---
# Nothing on the public site logs in until the shop ships. Payload provides
# editor auth. Revisit Supabase Auth / Auth0 / Clerk alongside Stripe.

# --- Set by the platform; do NOT add these yourself ---
# VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_REF, VERCEL_GIT_COMMIT_SHA,
# VERCEL_PROJECT_PRODUCTION_URL are provided by Vercel. NEXT_PHASE is set by
# Next during a build. They are read in payload.config.ts, next.config.ts and
# lib/site.ts to decide pool size, the environment badge, and canonical URLs.
#
# NEXT_PUBLIC_ENVIRONMENT, NEXT_PUBLIC_GIT_BRANCH and NEXT_PUBLIC_GIT_SHA are
# computed in next.config.ts and inlined at build time — setting them by hand
# would just be overwritten.
