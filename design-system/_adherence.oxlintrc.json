        "selector": "JSXOpeningElement[name.name='FaqAccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<FaqAccordionItem> doesn't accept that prop. Declared props: title, body."
