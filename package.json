{
  "name": "starfall-pub",
  "version": "0.0.0",
  "private": true,
  "description": "Pyrelight Press — monorepo for the Starfall and Pyrelight sites.",
  "engines": {
    "node": ">=20.0.0 <=26.x.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "cms": "pnpm --filter web payload",
    "migrate": "pnpm --filter web migrate",
    "migrate:create": "pnpm --filter web migrate:create"
  }
}
